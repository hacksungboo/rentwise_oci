# cp .env.example .env 후 값을 채우세요. .env 는 커밋 금지.

# --- 도메인 / 터널
PUBLIC_HOSTNAME=rentwise.ccmall.shop
CLOUDFLARE_TUNNEL_TOKEN=            # Cloudflare Zero Trust → Tunnels 에서 복사 (eyJ...)

# --- DB (Oracle Free 컨테이너). 영문·숫자만 권장
DB_IMAGE=gvenzl/oracle-free:23-slim
ORACLE_PASSWORD=
DB_USER=rentwise
DB_PASSWORD=
DB_SERVICE=FREEPDB1

# --- API
SESSION_SECRET=                     # openssl rand -hex 32
COOKIE_SECURE=true
ENGINE_MODE=mock                    # A 엔진 연동 후 real
OPENAI_API_KEY=                     # A 연동 후에만 사용
# 아이디:비밀번호:역할:이름:직원ID 를 ; 로 구분
DEMO_ACCOUNTS=admin:바꿀비밀번호:ADMIN:운영책임자:;e1:바꿀비밀번호:STAFF:김현우:E1;e2:바꿀비밀번호:STAFF:이서연:E2;e3:바꿀비밀번호:STAFF:박준호:E3

# --- 표시용
SERVER_LABEL=OCI ap-seoul-1 · team-4-1
IMAGE_TAG=local
BUILD_SHA=local
