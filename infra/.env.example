# cp .env.example .env 후 값을 채우세요. .env 는 커밋 금지.

# --- 도메인 / 터널
PUBLIC_HOSTNAME=rentwise.ccmall.shop
CLOUDFLARE_TUNNEL_TOKEN=            # Cloudflare Zero Trust → Tunnels 에서 복사 (eyJ...)

# --- DB 위치
#   분리형: DB_HOST=10.0.0.218 (team-4-2), COMPOSE_PROFILES 비움
#   단일 서버: DB_HOST=db, COMPOSE_PROFILES=localdb
DB_HOST=10.0.0.218
COMPOSE_PROFILES=
DB_PORT=1521

# --- DB 계정 (team-4-2 의 db-server/.env 와 같게). 영문·숫자만 권장
DB_IMAGE=gvenzl/oracle-free:23-slim
ORACLE_PASSWORD=
DB_USER=rentwise
DB_PASSWORD=
DB_SERVICE=FREEPDB1

# --- API
SESSION_SECRET=                     # openssl rand -hex 32
COOKIE_SECURE=true
ENGINE_MODE=mock                    # real: GPT 해석 + A 배정 엔진
OPENAI_API_KEY=                     # real 에서 필요. 채팅·GitHub 에 붙이지 말 것
OPENAI_MODEL=gpt-5.6-terra          # 해석/변경안 설명 공통, A 등록 가격 정책 적용
AI_BUDGET_USD=0                     # AI 누적 사용 한도(USD). 0 이면 유료 호출 차단. 시연 서버 권장 3
# 아이디:비밀번호:역할:이름:직원ID 를 ; 로 구분
DEMO_ACCOUNTS=admin:바꿀비밀번호:ADMIN:운영책임자:;e1:바꿀비밀번호:STAFF:김현우:E1;e2:바꿀비밀번호:STAFF:이서연:E2;e3:바꿀비밀번호:STAFF:박준호:E3

# --- 백업 (./scripts/backup.sh, 매시간: ./scripts/install-backup-cron.sh)
BACKUP_UPLOAD_URL=                  # 도쿄 terraform output -raw backup_upload_url (쓰기 전용, 비밀값)
BACKUP_ENCRYPT_KEY=                 # openssl rand -base64 32. 서울·도쿄 같은 값, 잃으면 복원 불가 → 비밀번호 관리자에 보관
BACKUP_LABEL=seoul                  # 버킷 안 경로 rentwise/<라벨>/
# 복원 서버(도쿄)에서만
BACKUP_READ_URL=                    # terraform output -raw backup_read_url (목록·다운로드 전용, 비밀값)
BACKUP_SOURCE_LABEL=seoul

# --- 표시용
SERVER_LABEL=OCI ap-seoul-1 · team-4-1
# 아래 4개는 배포 스크립트가 자동으로 기록합니다 (직접 바꾸지 마세요)
IMAGE_TAG=local
BUILD_SHA=local
API_IMAGE=rentwise-api
WEB_IMAGE=rentwise-web
