# cp .env.example .env 후 서버에 맞게. .env 는 커밋 금지.
# team-4-2 (모니터링 서버)
COMPOSE_PROFILES=server,agent
HOST_LABEL=team-4-2
MON_HOST=127.0.0.1
GRAFANA_ADMIN_PASSWORD=            # 영문·숫자 12자 이상. 채팅·GitHub 금지
GRAFANA_ROOT_URL=https://grafana.ccmall.shop
APP_SERVER_IP=10.0.0.198           # firewall.sh: 3000·3100·9090 을 이 IP 에서만 허용
RETENTION=3d

# team-4-1 (앱 서버) 에서는 아래처럼:
# COMPOSE_PROFILES=agent
# HOST_LABEL=team-4-1
# MON_HOST=10.0.0.218
